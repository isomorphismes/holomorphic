#version 300 es
precision highp float;
precision highp int;

/*__WEGERT_COLOR_CORE__*/

#define MAX_FACTORS 32
#define HOLOMORPHIC_COEFFICIENT_COUNT 5
#define REMOTE_POLE_COUNT 24

in vec2 v_ndc;
out vec4 frag_color;

uniform vec2 u_resolution;
uniform int u_zero_count;
uniform int u_pole_count;
uniform vec2 u_zero_positions[MAX_FACTORS];
uniform vec2 u_pole_positions[MAX_FACTORS];
uniform vec2 u_holomorphic_coefficients[HOLOMORPHIC_COEFFICIENT_COUNT];
uniform vec2 u_remote_pole_positions[REMOTE_POLE_COUNT];
uniform float u_zoom;
uniform int u_placement_kind;

vec2 complex_multiply(vec2 left, vec2 right) {
    return vec2(
        left.x * right.x - left.y * right.y,
        left.x * right.y + left.y * right.x
    );
}

void accumulate_complex_product(
    inout vec2 product,
    inout float logarithmic_scale,
    vec2 factor
) {
    if (dot(factor, factor) < 1.0e-16) {
        factor = vec2(1.0e-8, 0.0);
    }

    product = complex_multiply(product, factor);
    float scale = max(abs(product.x), abs(product.y));
    if (scale > 1.0e8 || scale < 1.0e-8) {
        product /= scale;
        logarithmic_scale += log(scale);
    }
}

void add_complex_product_contribution(
    vec2 product,
    float logarithmic_scale,
    float sign,
    inout float phase,
    inout float log_modulus
) {
    float scale = max(max(abs(product.x), abs(product.y)), 1.0e-20);
    vec2 normalized = product / scale;
    phase += sign * atan(normalized.y, normalized.x);
    log_modulus += sign * (
        logarithmic_scale
        + log(scale)
        + 0.5 * log(max(dot(normalized, normalized), 1.0e-16))
    );
}

vec2 holomorphic_q(vec2 z) {
    // Keep the normalization fixed in the mathematical plane rather than tied
    // to zoom, but make the live entire factor large enough to read on a phone.
    vec2 u = z / 3.0;
    vec2 power = u;
    vec2 q = vec2(0.0);
    for (int index = 0; index < HOLOMORPHIC_COEFFICIENT_COUNT; ++index) {
        q += complex_multiply(u_holomorphic_coefficients[index], power);
        power = complex_multiply(power, u);
    }
    return q;
}

float circle_mask(vec2 point, vec2 center, float radius) {
    return 1.0 - smoothstep(radius - 1.25, radius + 1.25, length(point - center));
}

float ring_mask(vec2 point, vec2 center, float outer_radius, float inner_radius) {
    return max(
        0.0,
        circle_mask(point, center, outer_radius) -
        circle_mask(point, center, inner_radius)
    );
}

float line_mask(vec2 point, vec2 start, vec2 finish, float half_width) {
    vec2 segment = finish - start;
    float denominator = max(dot(segment, segment), 1.0e-6);
    float along = clamp(dot(point - start, segment) / denominator, 0.0, 1.0);
    float distance_to_line = length(point - (start + along * segment));
    return 1.0 - smoothstep(half_width - 1.0, half_width + 1.0, distance_to_line);
}

void main() {
    float pixel_radius = 0.42 * min(u_resolution.x, u_resolution.y) * u_zoom;
    vec2 pixel = gl_FragCoord.xy - 0.5 * u_resolution;
    vec2 z = pixel / pixel_radius;
    float view_outer_radius = length(0.5 * u_resolution) / pixel_radius;

    // H(z) = exp(q(z)) is entire and nonzero. Wegert coloring only uses
    // phase modulo tau and log-modulus modulo log(10), so reduce the large
    // entire contribution before adding the explicit divisor. This prevents
    // far-zoom fp32 cancellation from making user zeros/poles numerically vanish.
    vec2 q = holomorphic_q(z);
    float phase = q.y - WEGERT_TAU * floor(q.y / WEGERT_TAU);
    float log_modulus = q.x - WEGERT_LOG_10 * floor(q.x / WEGERT_LOG_10);

    // R(z): accumulate all explicit zeros and poles with complex multiplies.
    // Extract phase/log-modulus only once for the numerator and denominator.
    // This keeps adding many user zeros cheap enough for the PowerVR phone and
    // preserves analytic cancellation when zeros approach wandering poles.
    vec2 zero_product = vec2(1.0, 0.0);
    float zero_logarithmic_scale = 0.0;
    for (int index = 0; index < MAX_FACTORS; ++index) {
        if (index >= u_zero_count) break;
        accumulate_complex_product(
            zero_product,
            zero_logarithmic_scale,
            z - u_zero_positions[index]
        );
    }

    vec2 pole_product = vec2(1.0, 0.0);
    float pole_logarithmic_scale = 0.0;
    for (int index = 0; index < MAX_FACTORS; ++index) {
        if (index >= u_pole_count) break;
        accumulate_complex_product(
            pole_product,
            pole_logarithmic_scale,
            z - u_pole_positions[index]
        );
    }

    // The 24 wanderers are persistent poles, but their divisor contribution
    // can be canceled by user zeros exactly like any mathematical pole factor.
    for (int index = 0; index < REMOTE_POLE_COUNT; ++index) {
        accumulate_complex_product(
            pole_product,
            pole_logarithmic_scale,
            z - u_remote_pole_positions[index]
        );
    }

    add_complex_product_contribution(
        zero_product, zero_logarithmic_scale, 1.0, phase, log_modulus
    );
    add_complex_product_contribution(
        pole_product, pole_logarithmic_scale, -1.0, phase, log_modulus
    );

    vec3 color = wegert_color_from_phase_log_modulus(phase, log_modulus);

    // Everything below is interaction overlay, not the value -> Wegert color oracle.
    for (int index = 0; index < MAX_FACTORS; ++index) {
        if (index >= u_zero_count) break;
        vec2 center = 0.5 * u_resolution + u_zero_positions[index] * pixel_radius;
        vec2 marker_offset = abs(gl_FragCoord.xy - center);
        if (max(marker_offset.x, marker_offset.y) > 11.0) continue;
        float mark = ring_mask(gl_FragCoord.xy, center, 9.0, 5.0);
        color = mix(color, vec3(0.04), mark);
        float highlight = ring_mask(gl_FragCoord.xy, center, 6.8, 5.5);
        color = mix(color, vec3(0.98), highlight);
    }

    for (int index = 0; index < MAX_FACTORS; ++index) {
        if (index >= u_pole_count) break;
        vec2 center = 0.5 * u_resolution + u_pole_positions[index] * pixel_radius;
        vec2 marker_offset = abs(gl_FragCoord.xy - center);
        if (max(marker_offset.x, marker_offset.y) > 11.0) continue;
        float pole_mark = max(
            line_mask(
                gl_FragCoord.xy,
                center + vec2(-7.0, -7.0),
                center + vec2(7.0, 7.0),
                2.4
            ),
            line_mask(
                gl_FragCoord.xy,
                center + vec2(-7.0, 7.0),
                center + vec2(7.0, -7.0),
                2.4
            )
        );
        color = mix(color, vec3(0.04), pole_mark);
    }

    // Remote poles are persistent mathematical poles. Draw their X markers
    // when zoom brings them into the viewport, without making them editable.
    // Use a cheap diagonal-distance mask so the phone fast path stays light.
    for (int index = 0; index < REMOTE_POLE_COUNT; ++index) {
        vec2 center = 0.5 * u_resolution
            + u_remote_pole_positions[index] * pixel_radius;
        if (
            center.x < -10.0 || center.x > u_resolution.x + 10.0 ||
            center.y < -10.0 || center.y > u_resolution.y + 10.0
        ) {
            continue;
        }
        vec2 offset = abs(gl_FragCoord.xy - center);
        float extent = max(offset.x, offset.y);
        float diagonal = abs(offset.x - offset.y);
        float remote_mark =
            (1.0 - smoothstep(1.4, 2.6, diagonal)) *
            (1.0 - smoothstep(7.0, 8.5, extent));
        color = mix(color, vec3(0.04), remote_mark);
    }

    float placement_radius = clamp(0.048 * min(u_resolution.x, u_resolution.y), 26.0, 38.0);
    vec2 zero_center = vec2(placement_radius + 16.0, placement_radius + 16.0);
    vec2 pole_center = vec2(
        zero_center.x + 2.0 * placement_radius + 14.0,
        zero_center.y
    );

    bool zero_selected = u_placement_kind == 0;
    bool pole_selected = u_placement_kind == 1;

    float zero_disk = circle_mask(gl_FragCoord.xy, zero_center, placement_radius);
    color = mix(color, zero_selected ? vec3(0.94) : vec3(0.04), zero_disk * 0.86);
    vec3 zero_mark_color = zero_selected ? vec3(0.05) : vec3(0.96);
    float zero_mark = ring_mask(
        gl_FragCoord.xy,
        zero_center,
        placement_radius * 0.40,
        placement_radius * 0.25
    );
    color = mix(color, zero_mark_color, zero_mark);

    float pole_disk = circle_mask(gl_FragCoord.xy, pole_center, placement_radius);
    color = mix(color, pole_selected ? vec3(0.94) : vec3(0.04), pole_disk * 0.86);
    vec3 pole_mark_color = pole_selected ? vec3(0.05) : vec3(0.96);
    float pole_mark = max(
        line_mask(
            gl_FragCoord.xy,
            pole_center + vec2(-9.0, -9.0),
            pole_center + vec2(9.0, 9.0),
            2.2
        ),
        line_mask(
            gl_FragCoord.xy,
            pole_center + vec2(-9.0, 9.0),
            pole_center + vec2(9.0, -9.0),
            2.2
        )
    );
    color = mix(color, pole_mark_color, pole_mark);

    frag_color = vec4(color, 1.0);
}
