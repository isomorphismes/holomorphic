#!/usr/bin/env grease
# Kitchen invokes this through its verified Grease runtime after generation.
# Inputs are exact generated bytes and their receipt, never a handwritten asset.
set -o errexit -o nounset -o pipefail
test "$#" -eq 3
var fragment = ARGV[0]
var receipt = ARGV[1]
var output = ARGV[2]
test -s "$fragment"
test -s "$receipt"
test "$(grep -Fxc 'compiler=idris2-glsles' "$receipt")" -eq 1
test "$(grep -c '^compiler=' "$receipt")" -eq 1
test "$(grep -Fxc 'backend_repo=fuego-ironworks/idris-shader-backend' "$receipt")" -eq 1
test "$(grep -c '^backend_repo=' "$receipt")" -eq 1
test "$(grep -Fxc 'application_repo=isomorphismes/holomorphic' "$receipt")" -eq 1
test "$(grep -c '^application_repo=' "$receipt")" -eq 1
test "$(grep -Ec '^backend_commit=[0-9a-f]{40}$' "$receipt")" -eq 1
test "$(grep -c '^backend_commit=' "$receipt")" -eq 1
test "$(grep -Ec '^application_commit=[0-9a-f]{40}$' "$receipt")" -eq 1
test "$(grep -c '^application_commit=' "$receipt")" -eq 1
test "$(grep -c '^fragment_sha256=' "$receipt")" -eq 1
var digest = $(sha256sum "$fragment" | cut -d ' ' -f 1)
test "$(grep -Fxc "fragment_sha256=$digest" "$receipt")" -eq 1
var length = $(wc -c < "$fragment" | tr -d '[:space:]')
var backend_commit = $(sed -n 's/^backend_commit=//p' "$receipt")
var application_commit = $(sed -n 's/^application_commit=//p' "$receipt")
mkdir -p "$(dirname "$output")"
printf '#define HOLOMORPHIC_REQUIRE_GENERATED_SHADER 1\n#define HOLOMORPHIC_FRAGMENT_SHA256 "%s"\n#define HOLOMORPHIC_FRAGMENT_LENGTH %su\n#define HOLOMORPHIC_BACKEND_COMMIT "%s"\n#define HOLOMORPHIC_APPLICATION_COMMIT "%s"\n' \
  "$digest" "$length" "$backend_commit" "$application_commit" > "$output.tmp"
mv "$output.tmp" "$output"
printf 'shader_binding=checked-idris\nfragment_sha256=%s\nfragment_bytes=%s\n' "$digest" "$length"
sha256sum "$fragment" "$receipt" "$output"
