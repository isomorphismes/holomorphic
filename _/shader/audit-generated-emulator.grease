#!/usr/bin/env grease
set -o errexit -o nounset -o pipefail

if (int($#) !== 1) { echo 'requires absolute Holomorphic checkout' >&2; exit 2 }
var root = $1
case "$root" in /*) ;; *) exit 2 ;; esac
test "$root" = "$(realpath -- "$root")"
var aici = "$root/_/holo-aici"
var ithon = "$root/_/ithon"
test "$(git -C "$aici" rev-parse HEAD)" = 76043b9a16883ea8366b7c347dbf2639833d9307
test "$(git -C "$ithon" rev-parse HEAD)" = d6e83969f82512e920fb17b44326cb54f31d015c
git -C "$aici" diff HEAD --exit-code --quiet
git -C "$ithon" diff HEAD --exit-code --quiet
var python = "$(command -v python3)"
test -x "$python"
test -s "$root/generated-holomorphic-emulator.log"
var expected = "$root/artifacts/_/shader/generated/continuation.frag"
var submitted = "$root/generated-holomorphic-submitted.frag"
test -s "$expected"
unzip -p "$root/artifacts/android/app/build/outputs/apk/debug/app-debug.apk" \
    assets/continuation.frag > "$submitted"
test -s "$submitted"
env ITHON_PYTHON="$python" "$ithon/ithon" \
    "$aici/examples/autogenerated/holomorphic-phase-log/HolomorphicAcceptance.pi" \
    provenance "$expected" "$submitted" "$root/generated-holomorphic-emulator.log" \
    > "$root/generated-holomorphic-independent-acceptance.log" 2>&1
env ITHON_PYTHON="$python" "$ithon/ithon" \
    "$aici/examples/autogenerated/holomorphic-phase-log/HolomorphicAcceptance.pi" \
    gpu-audit "$root/generated-holomorphic-emulator.log" \
    >> "$root/generated-holomorphic-independent-acceptance.log" 2>&1
env ITHON_PYTHON="$python" "$ithon/ithon" \
    "$aici/examples/autogenerated/holomorphic-phase-log/HolomorphicAcceptance.pi" \
    large-q-audit "$root/generated-holomorphic-emulator.log" \
    >> "$root/generated-holomorphic-independent-acceptance.log" 2>&1
cat "$root/generated-holomorphic-independent-acceptance.log"
